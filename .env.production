# Configuration web Firebase du projet de production (snowro-app). Ces valeurs
# sont publiques par nature : elles se retrouvent telles quelles dans le code
# du site envoyé à chaque navigateur. La sécurité repose sur les Firestore
# rules, les Cloud Functions et les restrictions de la clé dans Google Cloud,
# jamais sur le secret de ces valeurs. Chargé par `vite build` (mode production).
VITE_FIREBASE_API_KEY=AIzaSyAqLlr7fVZJdDuF_e04Um-uY6fyNWVWFD0
VITE_FIREBASE_AUTH_DOMAIN=snowro-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=snowro-app
VITE_FIREBASE_STORAGE_BUCKET=snowro-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=938452694811
VITE_FIREBASE_APP_ID=1:938452694811:web:879e90e1078fddca8e45be
# Jamais les émulateurs en production (écrase un éventuel .env local).
VITE_UTILISER_EMULATEURS=
# Clé publiable Stripe (pas un secret). Sa présence active le paiement réel
# dans l'app ; aller de pair avec PAIEMENT_REEL=true dans
# functions/.env.snowro-app (docs/stripe.md). pk_test_ = sandbox
# « environnement de test Snowro » : aucun argent réel.
VITE_STRIPE_CLE_PUBLIQUE=pk_test_51UKYSpPPqLGXXv6l25nIbHzy0DHywCYtF5fcDTBZdB7DoYO6CNTkPOj43BPwtCwCbnQAN9a40WXp1B07XDFgPo3200RiDpji7r
