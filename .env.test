VITE_FIREBASE_AUTH_DOMAIN=snowro-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=snowro-test
VITE_FIREBASE_STORAGE_BUCKET=snowro-test.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=515068086679
VITE_FIREBASE_APP_ID=1:515068086679:web:a7a794e716c6ca31119cd2
VITE_UTILISER_EMULATEURS=
# Même sandbox Stripe que la production pour l'instant (mode test).
VITE_STRIPE_CLE_PUBLIQUE=pk_test_51UKYSpPPqLGXXv6l25nIbHzy0DHywCYtF5fcDTBZdB7DoYO6CNTkPOj43BPwtCwCbnQAN9a40WXp1B07XDFgPo3200RiDpji7r


# Page /credit-impot : sur le test seulement, en attendant les vérifications
# fiscales et les fonctions qu'elle annonce (factures, relevé de fin d'année).
VITE_PAGE_CREDIT_IMPOT=1

# Textos (Twilio) : section « Votre cellulaire » et consentement « Notifications
# SMS » dans Paramètres (aussi en production, .env.production).
VITE_TEXTOS=1

# Mesure d'audience (Google Analytics 4) : identifiant du flux web « G-… »
# (public, comme la configuration Firebase). Vide : aucun outil chargé ni
# bandeau affiché. Rempli : bandeau de consentement, rien avant « Accepter »
# (src/lib/mesure.js, docs/mesure.md).
# Même propriété que la production pour valider le bandeau : filtrer sur le
# nom d'hôte test.snowro.com dans les rapports (ou retirer après validation).
VITE_GA_ID=G-62SJDTB2KX
