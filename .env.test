# Configuration web Firebase de l'environnement de test (projet snowro-test,
# test.snowro.com). Publique par nature, comme .env.production. Chargé par
# `vite build --mode test` (branche test, .github/workflows/deployer-firebase.yml).
# Valeurs à remplir avec le bloc firebaseConfig de l'application web
# « snowro-test-web » (console Firebase > Paramètres du projet).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=snowro-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=snowro-test
VITE_FIREBASE_STORAGE_BUCKET=snowro-test.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_UTILISER_EMULATEURS=
# Même sandbox Stripe que la production pour l'instant (mode test).
VITE_STRIPE_CLE_PUBLIQUE=pk_test_51UKYSpPPqLGXXv6l25nIbHzy0DHywCYtF5fcDTBZdB7DoYO6CNTkPOj43BPwtCwCbnQAN9a40WXp1B07XDFgPo3200RiDpji7r
