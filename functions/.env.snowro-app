# Paramètres (non secrets) des Cloud Functions pour le projet snowro-app,
# lus au déploiement (functions/src/paiements.js). Les secrets sont dans
# Secret Manager, jamais ici.
# PAIEMENT_REEL : false = paiement simulé ; true = Stripe (à changer en même
# temps que VITE_STRIPE_CLE_PUBLIQUE dans .env.production, voir docs/stripe.md).
PAIEMENT_REEL=true
URL_SITE=https://snowro.com
# TWILIO_NUMERO : numéro Twilio d'envoi des textos (E.164, ex. +14185551234).
# Vide = textos inactifs (functions/src/sms.js).
TWILIO_NUMERO=+15818925901
# STRIPE_MODE : « test » (sandbox, sk_test_) ou « live » (argent réel, sk_live_),
# à changer en même temps que STRIPE_SECRET_KEY et la clé publiable (docs/stripe.md).
STRIPE_MODE=live
# ADMIN_UIDS : UID Firebase (Authentication) qui ont accès au tableau /admin,
# séparés par des virgules. Un UID n'est pas un renseignement personnel ; ne
# jamais mettre de courriel ici (dépôt public). Vide = personne.
ADMIN_UIDS=6JR9qGu7FbbxcC4jwEVHvXT6cQg2
