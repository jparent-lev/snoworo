VITE_UTILISER_EMULATEURS=

# Mesure d'audience Google Analytics 4 (G-…), vide = désactivée. Voir docs/mesure.md.
VITE_GA_ID=

# Clé de site reCAPTCHA Enterprise pour Firebase App Check (publique). Vide :
# App Check inactif. Voir docs/app-check.md.
VITE_RECAPTCHA_CLE=
