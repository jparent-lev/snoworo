rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function estProprietaire(userId) {
      return estConnecte() && request.auth.uid == userId;
    }

    function champsProteges() {
      // consents, proSubscription, ville, villeGeoId, stripeConnectAccountId,
      // connectStatus : jamais en écriture directe côté client. ville/villeGeoId
      // sont dérivés par géocodage serveur ; connectStatus n'est confirmé que
      // par la Cloud Function qui reçoit le webhook Stripe — voir
      // snowro-changements-claude-code.md § 1 : une donnée qui détermine un
      // comportement de sécurité/matching/paiement ne doit jamais être
      // manipulable par le client, au même titre que les consentements.
      // ratingAvg, ratingCount, nbJobsCompletees : la réputation d'un
      // déneigeur, mise à jour seulement par les Cloud Functions (sinon chacun
      // pourrait se donner 5 étoiles).
      return ['consents', 'proSubscription', 'ville', 'villeGeoId', 'stripeConnectAccountId', 'connectStatus',
              'ratingAvg', 'ratingCount', 'nbJobsCompletees'];
    }

    function abonneProActif() {
      return estConnecte() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.proSubscription.status == 'active';
    }

    // ---- users ----
    // Lecture par le propriétaire SEULEMENT : la fiche contient courriel et
    // téléphone (Loi 25). Ce que les autres doivent voir (prénom, note) est
    // recopié dans la demande au moment où c'est pertinent.
    match /users/{userId} {
      allow read: if estProprietaire(userId);
      allow create: if estProprietaire(userId) &&
        !request.resource.data.keys().hasAny(champsProteges());
      allow update: if estProprietaire(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(champsProteges());
      allow delete: if false;
    }

    // ---- demandes ----
    // Toutes les écritures passent par les Cloud Functions du cycle de vie
    // (functions/src/cycleDemande.js : publier, accepter, marquer faite,
    // confirmer, signaler, annuler tant qu'ouverte, augmenter l'offre) : le
    // premier-arrivé-premier-servi, le filtre de ville en exclusion dure et le
    // calcul du paiement ne dépendent jamais du client.
    // Lecture ouverte aux connectés (nécessaire au matching) : le document ne
    // contient qu'un geohash arrondi (~150 m) et un prénom.
    match /demandes/{demandeId} {
      allow read: if estConnecte();
      allow write: if false;

      // Adresse exacte : le client, et le déneigeur une fois qu'il a accepté.
      match /prive/{docId} {
        allow read: if estConnecte() &&
          (request.auth.uid == get(/databases/$(database)/documents/demandes/$(demandeId)).data.donneurOuvrageId ||
           request.auth.uid == get(/databases/$(database)/documents/demandes/$(demandeId)).data.deneigeurId);
        allow write: if false;
      }
    }

    // ---- config (paramètres internes) ----
    // config/frais : { fraisFixe, fraisPct }. Lecture publique — ce ne sont pas
    // des données sensibles, et le calculateur de frais du site vitrine doit
    // afficher exactement les mêmes chiffres que l'app (voir
    // design_handoff_snowro_site/README.md § Frais). Écriture jamais côté
    // client : ajustée uniquement via la Cloud Function de paiement (à venir)
    // ou la console Firebase — voir snowro-changements-claude-code.md § 2.
    match /config/frais {
      allow read: if true;
      allow write: if false;
    }
    // Tout autre document sous config/ reste fermé par défaut.
    match /config/{document} {
      allow read, write: if false;
    }

    // ---- listeAttente (site vitrine de pré-lancement) ----
    // Jamais de lecture/écriture directe côté client : rejoindreListeAttente
    // (callable, public, sans authentification) valide et géocode avant
    // d'écrire via l'Admin SDK. Voir design_handoff_snowro_site/README.md.
    match /listeAttente/{document} {
      allow read, write: if false;
    }

    // ---- messagesContact (formulaire « Nous écrire » du site vitrine) ----
    // Même principe que listeAttente : écrit uniquement par
    // envoyerMessageContact (Admin SDK), jamais lu depuis un client.
    match /messagesContact/{document} {
      allow read, write: if false;
    }

    // ---- zonesStats / zonesStatsParVille (agrégats anonymisés, Snowro Pro) ----
    match /zonesStats/{statId} {
      allow read: if abonneProActif();
      allow write: if false; // uniquement via Cloud Function planifiée (Admin SDK)
    }

    match /zonesStatsParVille/{statId} {
      allow read: if abonneProActif();
      allow write: if false; // uniquement via Cloud Function planifiée (Admin SDK)
    }

    // ---- offresCiblees (Snowro Pro) ----
    match /offresCiblees/{offreId} {
      allow read: if estConnecte() &&
        (request.auth.uid == resource.data.deneigeurProId ||
         request.auth.uid == resource.data.utilisateurCibleId);
      allow write: if false; // création forcée via Cloud Function (valide le consentement avant écriture)
    }

    // ---- messages ----
    // conversationId == demandeId : la conversation n'existe qu'après un match confirmé,
    // et n'est visible qu'aux deux parties du match (jamais avant, jamais à un tiers).
    function participantAuMatch(demandeId) {
      let demande = get(/databases/$(database)/documents/demandes/$(demandeId)).data;
      return demande.statut in ['matchee', 'faite', 'completee', 'signalee'] &&
        (request.auth.uid == demande.donneurOuvrageId || request.auth.uid == demande.deneigeurId);
    }

    match /messages/{conversationId}/messages/{messageId} {
      allow read: if estConnecte() && participantAuMatch(conversationId);
      allow create: if estConnecte() && participantAuMatch(conversationId) &&
        request.resource.data.expediteurId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
